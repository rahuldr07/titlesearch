+def _docx_text(path: Path) -> str:
+    """Read a .docx. Prefer pandoc; fall back to python-docx.
+
+    pandoc was the only reader, so on a machine without it the two .docx
+    sources silently produced no fields and the orders vanished from the seed —
+    a missing system binary looking exactly like a missing report.
+
+    python-docx is already a dependency (render.py writes Shape A with it), so
+    the fallback costs nothing and removes a system requirement. One paragraph
+    per line matches pandoc's `plain` output closely enough for
+    `parse_shape_a`, which terminates a value at end-of-line.
+    """
+    try:
         return subprocess.run(["pandoc", "-t", "plain", str(path)],
                               capture_output=True, text=True).stdout
+    except FileNotFoundError:
+        from docx import Document
+        return chr(10).join(p.text for p in Document(str(path)).paragraphs)
+
+
+def _text(path: Path, kind, pages):
+    if kind == "docx":
+        return _docx_text(path)
     return subprocess.run(
         ["pdftotext", "-layout", "-f", str(pages[0]), "-l", str(pages[1]),
          str(path), "-"], capture_output=True, text=True).stdout
