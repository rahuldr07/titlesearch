+def v14_liens_survive_chain_termination(report, all_mortgage_blocks=None) -> Result:
+    """R15 — a lien survives an arm's-length sale.
+
+    Chain termination sets SEARCH DEPTH. It never decides lien disposition. The
+    only thing that may suppress a lien is a **verified release**: one whose
+    reference matches the instrument it discharges.
+
+    This is the assertion R15 mandated and the highest-risk regression in the
+    system. The prototype's behaviour was audited and found correct — exactly
+    one write to `released_by`, reachable only through a reference-matched
+    release — but correct-by-inspection is not the same as guarded, and the
+    audit was a point-in-time reading of code that Gate 6 is about to move.
+
+    The check: every block present before filtering and absent after it must
+    carry a release. A block that vanished without one was dropped by depth,
+    which is the defect.
+
+    **Fails closed when it cannot see the pre-filter set.** Returning "not
+    applicable" would make an unprovable report indistinguishable from a clean
+    one, and this codebase already has a name for that failure — `unverifiable`
+    looking like `confident`, the shape that produced the MERS phantom. For
+    R15, silence is not a pass.
+    """
+    blocks = all_mortgage_blocks
+    if blocks is None:
+        blocks = getattr(report, "_all_mortgage_blocks", None)
+    if blocks is None:
+        return Result(
+            "14_liens_survive_termination", False,
+            "pre-suppression mortgage set unavailable; R15 could not be checked")
+
+    surviving = {id(m) for m in report.mortgages}
+    suppressed = [m for m in blocks if id(m) not in surviving]
+    unreleased = [m for m in suppressed if getattr(m, "released_by", None) is None]
+
+    def _name(m):
+        rec = m.doc.recording
+        return (str(rec.instrument_no.value) if rec.instrument_no.is_present
+                else str(rec.book_page.value) if rec.book_page.is_present else "?")
+
+    return Result(
+        "14_liens_survive_termination", not unreleased,
+        (f"{len(suppressed)} suppressed, all released"
+         if not unreleased
+         else f"suppressed without a verified release: {[_name(m) for m in unreleased]}"))
+
+
