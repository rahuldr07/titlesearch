+# R15 — the only reasons an encumbrance may leave the report.
+#
+# Every one is a positive finding about the instrument itself. None is a
+# statement about the chain, which is the whole point: chain termination sets
+# SEARCH DEPTH and never lien disposition.
+PERMITTED_SUPPRESSIONS = frozenset({
+    "verified_release",        # R15/R16 — reference-matched release
+    "satisfied",               # R13 — judgment status
+    "released",
+    "canceled",
+    "vacated",
+    "duplicate",
+    "personal_property_only",  # R20 — UCC collateral test
+    "re_recording_of",         # R14 — same instrument, recorded twice
+})
+
+# Reasons that are themselves the defect. Named so a future author who reaches
+# for one gets a failing validator rather than a plausible-looking report.
+FORBIDDEN_SUPPRESSIONS = frozenset({
+    "chain_terminated",
+    "out_of_chain",
+    "search_depth",
+    "before_terminator",
+    "arms_length_sale",
+})
+
+
+def instrument_key(doc) -> str | None:
+    """A stable identity for an instrument.
+
+    Deliberately not `id()`. Assembly may rebuild an equal object — a
+    re-record collapse does exactly that — and an identity comparison then
+    reports a lien as suppressed when it is present under a new object. That is
+    a false failure on the one rule that must not cry wolf.
+
+    Caption and date are not identity. Two unrelated judgments can share both,
+    so inventing a fallback from them lets one survivor hide another missing
+    instrument. Missing recording identity therefore fails closed in v14.
+    """
+    rec = doc.recording
+    if rec.instrument_no.is_present:
+        return f"inst:{str(rec.instrument_no.value).strip().upper()}"
+    if rec.book_page.is_present:
+        return f"bp:{str(rec.book_page.value).strip().upper()}"
+    return None
+
+
+def _suppression_reason(item) -> str | None:
+    """Why this instrument left the report, as recorded by assembly."""
+    reason = getattr(item, "suppression_reason", None)
+    if reason:
+        return str(reason)
+    # A matched release is the mortgage path's way of saying the same thing.
+    if getattr(item, "released_by", None) is not None:
+        return "verified_release"
+    return None
+
+
+def v14_liens_survive_chain_termination(report, pre_suppression=None) -> Result:
+    """R15 — an encumbrance survives an arm's-length sale.
+
+    Chain termination sets SEARCH DEPTH. It never decides lien disposition. An
+    encumbrance may leave the report only for a reason that is a finding about
+    the instrument: a reference-matched release, a R13 status exclusion, the
+    R20 collateral test, a R14 re-record collapse.
+
+    Covers **every lien-bearing output**, not only mortgages. Judgments, tax
+    liens and UCC filings are the canonical R15 case — the rule was written
+    because a judgment against the current owner survives the sale that
+    preceded it — and an earlier version of this validator checked mortgages
+    alone, so removing an active judgment passed.
+
+    **Fails closed when it cannot see the pre-suppression sets.** Returning "not
+    applicable" would make an unprovable report indistinguishable from a clean
+    one, and this codebase already has a name for that failure: `unverifiable`
+    looking like `confident`, the shape that produced the MERS phantom.
+    """
+    sets = pre_suppression or {}
+    blocks = sets.get("mortgages", getattr(report, "_all_mortgage_blocks", None))
+    liens = sets.get("liens", getattr(report, "_all_lien_documents", None))
+    if blocks is None or liens is None:
+        missing = [n for n, v in (("mortgages", blocks), ("liens", liens)) if v is None]
+        return Result(
+            "14_liens_survive_termination", False,
+            f"pre-suppression set unavailable for {missing}; R15 could not be checked")
+
+    problems: list[str] = []
+    # Counters preserve multiplicity. A set lets one surviving item hide a
+    # second, distinct pre-suppression item with the same recording key.
+    surviving_mortgages = Counter(instrument_key(m.doc) for m in report.mortgages)
+    surviving_liens = Counter(instrument_key(d) for d in report.judgments_liens)
+
+    for item, doc, survivors in (
+        [(m, m.doc, surviving_mortgages) for m in blocks]
+        + [(d, d, surviving_liens) for d in liens]
+    ):
+        reason = _suppression_reason(item)
+        key = instrument_key(doc)
+        if key is None:
+            label = doc.caption.value if doc.caption.is_present else str(doc.doc_type)
+            problems.append(
+                f"{label}: stable recording identity unavailable; R15 could not be checked")
+            continue
+        present = survivors[key] > 0
+        if present:
+            survivors[key] -= 1
+            # Declaring a forbidden reason is a defect even if the instrument
+            # happens to still be rendered — the next edit will honour it.
+            if reason in FORBIDDEN_SUPPRESSIONS:
+                problems.append(f"{key}: chain-based suppression reason {reason!r}")
+            continue
+        if reason is None:
+            problems.append(f"{key}: suppressed with no reason")
+        elif reason in FORBIDDEN_SUPPRESSIONS:
+            problems.append(f"{key}: suppressed by {reason!r} — termination is not a disposition")
+        elif reason not in PERMITTED_SUPPRESSIONS:
+            problems.append(f"{key}: suppressed by unrecognised reason {reason!r}")
+
+    checked = len(blocks) + len(liens)
+    return Result(
+        "14_liens_survive_termination", not problems,
+        f"{checked} encumbrances checked, all dispositions permitted"
+        if not problems else "; ".join(problems))
+
+
