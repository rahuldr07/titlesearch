# TitlePipe Core API.
#
# Build context is the repository root, because the service depends on
# `libs/domain` by path and a narrower context could not see it.
#
#   docker build -f infra/containers/Dockerfile.core-api -t titlepipe/core-api:dev .
#
# One process per container. Scaling is replicas, not workers — the platform
# owns supervision, and an in-container process manager hides crashes from it.

# ---------------------------------------------------------------- builder ---
FROM python:3.13-slim-bookworm AS builder

# Pinned by digest at release time. A floating tag on the tool that resolves
# every other dependency would make "frozen install" meaningless.
COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1 \
    UV_LINK_MODE=copy \
    UV_PYTHON_DOWNLOADS=never

WORKDIR /build

# Manifests first, so a source-only change does not invalidate the dependency
# layer.
COPY libs/domain/pyproject.toml libs/domain/
COPY services/core-api/pyproject.toml services/core-api/uv.lock services/core-api/

# The path dependency must exist before resolution, but its sources are copied
# after, so editing domain code does not rebuild the wheel cache.
COPY libs/domain/ libs/domain/
COPY services/core-api/ services/core-api/

WORKDIR /build/services/core-api

# --frozen fails if uv.lock disagrees with pyproject.toml, so an unlocked
# dependency cannot enter an image. --no-dev keeps the test and lint toolchain
# out of the runtime. --no-editable installs real copies rather than links.
RUN uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------- runtime ---
FROM python:3.13-slim-bookworm AS runtime

RUN groupadd --system --gid 10001 titlepipe \
    && useradd --system --uid 10001 --gid titlepipe --no-create-home titlepipe

ENV PATH="/app/.venv/bin:$PATH" \
    PYTHONUNBUFFERED=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY --from=builder --chown=titlepipe:titlepipe /build/services/core-api/.venv /app/.venv

# No ENV default for the deployment environment. The settings model
# requires it, so a deployment that forgets to set it fails at startup
# rather than booting this publicly-bound container in development mode
# with public docs and the placeholder seal password.
USER titlepipe
EXPOSE 8000

# A Python probe, not curl: the runtime image ships no shell utilities, and
# adding them to make a health check work enlarges the attack surface of every
# replica.
HEALTHCHECK --interval=30s --timeout=5s --start-period=10s --retries=3 \
    CMD ["python", "-c", "import urllib.request,sys; sys.exit(0 if urllib.request.urlopen('http://127.0.0.1:8000/health', timeout=4).status==200 else 1)"]

# No --reload, no --debug, one worker. Exec form so the process is PID 1 and
# receives SIGTERM directly for a graceful drain.
CMD ["uvicorn", "titlepipe_core.app:create_app", "--factory", \
     "--host", "0.0.0.0", "--port", "8000", "--no-access-log"]
