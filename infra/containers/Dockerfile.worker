# TitlePipe worker.
#
# Build context is the repository root, because the service depends on
# `libs/domain` and `libs/service-kit` by path.
#
#   docker build -f infra/containers/Dockerfile.worker -t titlepipe/worker:dev .
#
# A worker, not a server: no port is exposed and nothing listens. Its health
# check is the `check` command, which validates configuration and exits.

# ---------------------------------------------------------------- builder ---
FROM python:3.13-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/

# The venv is built at the path it will be READ from. uv bakes an ABSOLUTE
# interpreter path into each console-script trampoline, so a venv synced at
# /build/... and copied to /app/.venv leaves every entry point pointing at a
# directory the runtime stage does not have, and exec fails with ENOENT on the
# interpreter rather than on the script. UV_PYTHON_DOWNLOADS=never already
# forces the image's own /usr/local/bin/python3.13, so pyvenv.cfg's `home`
# resolves in the runtime stage too.
ENV UV_COMPILE_BYTECODE=1     UV_LINK_MODE=copy     UV_PYTHON_DOWNLOADS=never \
    UV_PROJECT_ENVIRONMENT=/app/.venv

WORKDIR /build

COPY libs/domain/pyproject.toml libs/domain/
COPY libs/service-kit/pyproject.toml libs/service-kit/
COPY services/worker/pyproject.toml services/worker/uv.lock services/worker/
COPY libs/domain/ libs/domain/
COPY libs/service-kit/ libs/service-kit/
COPY services/worker/ services/worker/

WORKDIR /build/services/worker
RUN uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------- runtime ---
FROM python:3.13-slim-bookworm AS runtime

RUN groupadd --system --gid 10001 titlepipe     && useradd --system --uid 10001 --gid titlepipe --no-create-home titlepipe

ENV PATH="/app/.venv/bin:$PATH"     PYTHONUNBUFFERED=1     PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY --from=builder --chown=titlepipe:titlepipe /app/.venv /app/.venv

# No ENV default for the deployment environment. The settings model
# requires it, so a deployment that forgets to set it fails at startup
# rather than booting this publicly-bound container in development mode
# with public docs and the placeholder seal password.
USER titlepipe

# Configuration validity is the only thing this worker can truthfully assert
# at this gate. `check` exits non-zero on invalid configuration, so a
# misconfigured replica is reported unhealthy rather than left to look idle.
HEALTHCHECK --interval=60s --timeout=10s --start-period=5s --retries=3     CMD ["titlepipe-worker", "check"]

CMD ["titlepipe-worker", "run"]
