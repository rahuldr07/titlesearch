# TitlePipe render worker.
#
# Build context is the repository root, because the service depends on
# `libs/domain` by path.
#
#   docker build -f infra/containers/Dockerfile.render-svc -t titlepipe/render-svc:dev .
#
# A worker, not a server: no port is exposed and nothing listens. Its health
# check is the `check` command, which validates configuration and exits.

# ---------------------------------------------------------------- builder ---
FROM python:3.13-slim-bookworm AS builder

COPY --from=ghcr.io/astral-sh/uv:0.11.26 /uv /uvx /bin/

ENV UV_COMPILE_BYTECODE=1     UV_LINK_MODE=copy     UV_PYTHON_DOWNLOADS=never

WORKDIR /build

COPY libs/domain/pyproject.toml libs/domain/
COPY services/render-svc/pyproject.toml services/render-svc/uv.lock services/render-svc/
COPY libs/domain/ libs/domain/
COPY services/render-svc/ services/render-svc/

WORKDIR /build/services/render-svc
RUN uv sync --frozen --no-dev --no-editable

# ---------------------------------------------------------------- runtime ---
FROM python:3.13-slim-bookworm AS runtime

RUN groupadd --system --gid 10001 titlepipe     && useradd --system --uid 10001 --gid titlepipe --no-create-home titlepipe

ENV PATH="/app/.venv/bin:$PATH"     PYTHONUNBUFFERED=1     PYTHONDONTWRITEBYTECODE=1

WORKDIR /app
COPY --from=builder --chown=titlepipe:titlepipe /build/services/render-svc/.venv /app/.venv

USER titlepipe

# Configuration validity is the only thing this worker can truthfully assert
# at this gate. `check` exits non-zero on invalid configuration, so a
# misconfigured replica is reported unhealthy rather than left to look idle.
HEALTHCHECK --interval=60s --timeout=10s --start-period=5s --retries=3     CMD ["titlepipe-render", "check"]

CMD ["titlepipe-render", "run"]
