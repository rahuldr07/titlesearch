{
  "name": "web-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "check:rules": "node scripts/check-rules.mjs",
    "knip": "knip",
    "size": "size-limit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@hookform/resolvers": "^5.4.0",
    "@tanstack/react-query": "^5.101.2",
    "@tanstack/react-router": "^1.170.18",
    "@tanstack/react-table": "^8.21.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@titlepipe/contract": "workspace:*",
    "@titlepipe/ui-tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "lucide-react": "^1.27.0",
    "pdfjs-dist": "5.4.296",
    "radix-ui": "^1.6.7",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-hook-form": "^7.82.0",
    "react-hotkeys-hook": "^5.3.3",
    "react-pdf": "^10.4.1",
    "react-zoom-pan-pinch": "^4.0.3",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "valibot": "^1.4.2",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@size-limit/preset-app": "^13.0.1",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-vitest": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/react": "^16.3.2",
    "@titlepipe/mocks": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "knip": "^6.29.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "size-limit": "^13.0.1",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "app bundle (js)",
      "path": "dist/assets/*.js",
      "limit": "320 kB"
    },
    {
      "name": "app bundle (css)",
      "path": "dist/assets/*.css",
      "limit": "40 kB"
    }
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
