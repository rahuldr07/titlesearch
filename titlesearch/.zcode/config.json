{
  "$schema": "https://json.schemastore.org/zcode-config.json",
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "{**/*.py,**/*.pyi}",
        "hooks": [
          {
            "type": "command",
            "command": "ruff check --fix \"$ZCODE_FILE_PATH\" && ruff format \"$ZCODE_FILE_PATH\"",
            "description": "ruff check+format edited Python files"
          }
        ]
      },
      {
        "matcher": "{**/*.ts,**/*.tsx,**/*.js,**/*.jsx,**/*.mjs,**/*.cjs}",
        "hooks": [
          {
            "type": "command",
            "command": "pnpm exec oxlint --fix \"$ZCODE_FILE_PATH\"",
            "description": "oxlint --fix edited JS/TS files"
          }
        ]
      }
    ]
  }
}
