# Normalize line endings: store text as LF in the repo, check out native.
# Prevents the CRLF/LF churn seen on Windows checkouts.
* text=auto

# Explicit binary types (never diffed or line-ending-converted).
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.pdf binary
*.zip binary
*.seed binary

# Unified diffs encode a blank context line as a single space, so git's
# whitespace check flags every one. Stripping them corrupts the patch.
*.patch -whitespace -text
*.diff  -whitespace -text
