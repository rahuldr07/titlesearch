# County search packages contain GLBA NPI — never in VCS (CONTEXT §19: 644 MB incident).
# Local upload/package storage lives OUTSIDE the working tree at an absolute configured
# path; /data/ is the gitignored dev default. The pnpm workspace dir packages/ (contract,
# ui, mocks — source code) IS tracked; the old prototype's uploads dir happened to share
# the name.
/data/
*.seed

# secrets
.env
.env.*
!.env.example

# python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
# uv.lock IS tracked — one committed lock per deployable is what makes a
# frozen install reproducible. Only build output and caches are ignored.
*.egg-info/
.coverage
.coverage.*
coverage.xml
htmlcov/

# node
node_modules/
dist/
.vite/

# test artifacts
test-results/
playwright-report/
.playwright-mcp/

# local artifacts
*.log
.DS_Store

# loose dev screenshots at the repo root (apps/ and docs/ assets are unaffected).
# Deliberate design/QA captures belong in docs/archive/, not the working root.
/*.png

# pdfjs worker copied from node_modules into public/ by scripts/copy-pdf-worker.mjs
# on every dev/build — a version-synced build artifact, not source.
apps/web/public/pdf.worker.min.mjs
