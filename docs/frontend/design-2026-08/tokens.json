{
  "color": {
    "ink": {
      "300": "#B9BEC9",
      "400": "#8A8E98",
      "500": "#6E7480",
      "700": "#454A55",
      "900": "#14161C"
    },
    "accent": {
      "base": "#5B4B8A",
      "hover": "#4C3E75",
      "border": "#C6BAE4",
      "tint": "#F1EEF9",
      "tintBorder": "#E4DDF4",
      "onDark": "#B7A6EE"
    },
    "surface": {
      "canvas": "#ECEEF3",
      "card": "#FFFFFF",
      "well": "#FBFBFD",
      "border": "#E4E7ED",
      "hairline": "#EDEFF3",
      "hairlineSoft": "#F3F4F7",
      "controlBorder": "#D6D9E1",
      "controlFill": "#FBFBFD"
    },
    "status": {
      "ok": "#2E6B4F",
      "okBg": "#EAF2ED",
      "okBorder": "#C2DEC9",
      "okMuted": "#9DC0AC",
      "warn": "#8A5B12",
      "warnBg": "#FBF3E4",
      "warnBorder": "#F3E7D3",
      "bad": "#A4291F",
      "badMuted": "#E4B0AA",
      "badBg": "#FDF3F2",
      "badBorder": "#F2A8A2"
    },
    "dark": {
      "base": "#1E1B2E",
      "deep": "#171424",
      "text": "#C9C5D8",
      "muted": "#8881A2",
      "hairline": "rgba(255,255,255,.07)"
    },
    "paper": {
      "scan": "#F7F5EF",
      "doc": "#FDFCFA",
      "border": "#DDD9D0",
      "ink": "#2C281F",
      "meta": "#5C5647",
      "stamp": "#7C6A55"
    }
  },
  "radius": {
    "kbd": 4,
    "inner": 6,
    "input": 10,
    "surface": 14,
    "pill": 999,
    "paper": 2,
    "rule": "inner = outer - gap; nest 10px wrapper + 4px padding -> 6px children"
  },
  "type": {
    "families": {
      "ui": "Plus Jakarta Sans",
      "data": "JetBrains Mono",
      "paper": "Source Serif 4"
    },
    "scale": {
      "label": 11,
      "meta": 13,
      "body": 16,
      "subject": 20,
      "title": 28,
      "verdict": 40
    },
    "weights": [
      400,
      500,
      600,
      700,
      800
    ],
    "rules": {
      "mono": "data only: refs, money, citations, hashes, timestamps, kbd",
      "caps": "sidebar rubrics (11px/.14em) and serif certificate headings only"
    }
  },
  "elevation": {
    "card": "0 1px 2px rgba(20,22,28,.04),0 10px 28px rgba(20,22,28,.06)",
    "modal": "0 24px 60px rgba(0,0,0,.3)",
    "modalScrim": "rgba(20,18,30,.45) + backdrop-blur(3px)",
    "paper": "0 1px 2px rgba(0,0,0,.18),0 10px 26px rgba(0,0,0,.13)"
  },
  "motion": {
    "state": "140ms ease (background/color/border/box-shadow)",
    "enter": "260ms cubic-bezier(.32,.72,0,1) fade + 6px rise",
    "move": "300ms cubic-bezier(.32,.72,0,1)",
    "never": [
      "bounce",
      "spring overshoot",
      "parallax",
      "hover scale"
    ]
  },
  "layout": {
    "sidebarWidth": 240,
    "minAppWidth": 1360,
    "gaps": [
      8,
      12,
      16,
      24,
      32
    ],
    "tableRowHeight": 60,
    "control": {
      "inputHeight": 38,
      "buttonHeight": 38,
      "chipHeight": 28
    }
  },
  "statusMarks": {
    "settled": "✓ #9DB6A8",
    "attend": "◆ #8A5B12",
    "defect": "◆ #A4291F",
    "quiet": "• #8A8E98",
    "tier": "T1 mono pill — ruinous fields only"
  }
}