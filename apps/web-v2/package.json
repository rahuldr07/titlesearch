{
  "name": "web-v2",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "test:e2e:live": "node e2e-live/buildBundles.mjs && node e2e-live/seedRulebook.mjs && playwright test --config playwright.live.config.ts",
    "storybook": "storybook dev -p 6007",
    "build-storybook": "storybook build",
    "check:rules": "node scripts/check-rules.mjs",
    "knip": "knip",
    "size": "size-limit"
  },
  "dependencies": {
    "@embedpdf/core": "^2.15.0",
    "@embedpdf/engines": "^2.15.0",
    "@embedpdf/pdfium": "^2.15.0",
    "@embedpdf/plugin-render": "^2.15.0",
    "@embedpdf/plugin-scroll": "^2.15.0",
    "@embedpdf/plugin-viewport": "^2.15.0",
    "@embedpdf/plugin-zoom": "^2.15.0",
    "@hookform/resolvers": "^5.4.0",
    "@panzoom/panzoom": "^4.6.2",
    "@react-aria/interactions": "^3.28.1",
    "@react-aria/live-announcer": "^3.5.1",
    "@tanstack/react-query": "^5.102.7",
    "@tanstack/react-router": "^1.170.32",
    "@tanstack/react-table": "^9.2.3",
    "@tanstack/react-virtual": "^3.14.6",
    "@titlepipe/contract": "workspace:*",
    "@titlepipe/ui-tokens": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "diff": "^9.0.0",
    "lucide-react": "^1.27.0",
    "motion": "^13.1.1",
    "react": "^19.2.7",
    "react-aria-components": "^1.20.0",
    "react-dom": "^19.2.7",
    "react-error-boundary": "^6.1.3",
    "react-hook-form": "^7.82.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tinykeys": "^4.0.0",
    "web-vitals": "^6.2.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.12.1",
    "@axe-core/react": "^4.13.0",
    "@babel/core": "^8.0.1",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@rolldown/plugin-babel": "^0.2.3",
    "@size-limit/preset-app": "^13.0.1",
    "@storybook/addon-a11y": "^10.5.4",
    "@storybook/addon-vitest": "^10.5.4",
    "@storybook/react-vite": "^10.5.4",
    "@tailwindcss/vite": "^4.3.3",
    "@tanstack/react-query-devtools": "^5.102.7",
    "@tanstack/react-router-devtools": "^1.167.1",
    "@testing-library/react": "^16.3.2",
    "@titlepipe/mocks": "workspace:*",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "@vitest/browser": "^4.1.10",
    "@vitest/browser-playwright": "^4.1.10",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.8.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.3",
    "globals": "^17.8.0",
    "knip": "^6.29.0",
    "msw": "^2.15.0",
    "prettier": "^3.9.6",
    "rollup-plugin-visualizer": "^7.1.1",
    "size-limit": "^13.0.1",
    "storybook": "^10.5.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.65.0",
    "vite": "^8.1.5",
    "vitest": "^4.1.10"
  },
  "size-limit": [
    {
      "name": "app bundle (js)",
      "path": "dist/assets/*.js",
      "limit": "320 kB"
    },
    {
      "name": "app bundle (css)",
      "path": "dist/assets/*.css",
      "limit": "40 kB"
    }
  ],
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
