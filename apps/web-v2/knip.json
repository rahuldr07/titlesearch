{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    ".storybook/{main,preview}.ts",
    "e2e/**/*.spec.ts",
    "e2e-live/**/*.spec.ts",
    "*.test.ts"
  ],
  "project": ["src/**/*.{ts,tsx}", ".storybook/**/*.ts", "scripts/*.mjs"],
  "ignoreDependencies": [
    "@titlepipe/ui-tokens",
    "tailwindcss",
    "@tanstack/react-table",
    "@tanstack/react-virtual",
    "react-hook-form",
    "@hookform/resolvers",
    "valibot",
    "cmdk",
    "lucide-react",
    "sonner",
    "react-pdf",
    "pdfjs-dist",
    "msw",
    "@testing-library/react",
    "@axe-core/playwright"
  ],
  "ignoreBinaries": ["psql"],
  "rules": {
    "types": "warn",
    "enumMembers": "warn"
  },
  "ignore": ["src/components/ui/**"]
}
