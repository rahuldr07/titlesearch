{
  "files": [],
  "references": [{ "path": "./tsconfig.app.json" }, { "path": "./tsconfig.node.json" }],
  /*
   * A solution-style config compiles nothing, so these options are inert for
   * `tsc -b` — they are here for TOOLS that read the project's root tsconfig
   * rather than walking its references. The shadcn CLI is one: without the
   * alias here it cannot resolve `@/components/ui` and writes to a directory
   * literally named `@`. The real declaration lives in tsconfig.app.json and
   * must stay in step with this one.
   */
  "compilerOptions": {
    "paths": { "@/*": ["./src/*"] }
  }
}
