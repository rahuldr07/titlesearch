{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": [
    ".storybook/{main,preview}.ts",
    "src/workbench/main.tsx",
    "e2e/**/*.spec.ts",
    "e2e/helpers/*.ts",
    "e2e-live/**/*.spec.ts",
    "*.test.ts"
  ],
  "project": [
    "src/**/*.{ts,tsx,css}",
    ".storybook/**/*.ts",
    "scripts/*.mjs"
  ],
  "ignoreDependencies": [
    "@tanstack/react-table",
    "react-hook-form",
    "@hookform/resolvers",
    "msw",
    "@testing-library/react"
  ],
  "ignoreBinaries": [
    "psql"
  ],
  "rules": {
    "types": "warn",
    "enumMembers": "warn"
  },
  "ignore": [
    "src/components/ui/**"
  ]
}
