# TitlePipe backend configuration — names and safe examples only.
#
# Never put a real secret in this file. It is checked in.
#
# The services do NOT read a .env file: `env_file=None` is set on every settings
# model, so configuration comes from the process environment and the platform
# supplies it. This file documents what those variables are called and what a
# safe value looks like. Copy it to `.env` for local use if your shell or
# compose setup loads one; `.env` is gitignored.
#
# Every variable below is optional — each has a development default that works
# out of the box. A deployed environment is different: staging and production
# refuse to start on an unsafe value, so the ones marked REQUIRED-WHEN-DEPLOYED
# must be supplied there.


# ---------------------------------------------------------------- Core API ---

# REQUIRED. development | test | staging | production
#
# There is no default. A forgotten variable must not silently mean
# "development": the container binds 0.0.0.0, so failing open would publish the
# API docs, the placeholder seal password and detailed exception bodies.
TITLEPIPE_ENVIRONMENT=development

# Bind address. Loopback is the safe local default; a deployed environment
# refuses it, because a container bound to loopback is unreachable through the
# proxy in front of it.
TITLEPIPE_HOST=127.0.0.1
TITLEPIPE_PORT=8000

# All three refuse to be true in staging or production.
TITLEPIPE_DEBUG=false
TITLEPIPE_RELOAD=false
TITLEPIPE_MOCK_AUTH_ENABLED=false

# Public API docs are for local work only. Deployed environments refuse them;
# the machine-readable schema stays available as a build artifact.
TITLEPIPE_DOCS_ENABLED=true

# Comma-separated exact origins. "*" is refused when deployed.
#
# An empty allowlist is refused too, UNLESS same-origin is declared below. That
# is the distinction: a same-origin deployment legitimately needs no CORS at
# all and is the safest arrangement, but an operator who simply forgot to set
# the allowlist looks identical — so the safe case is opted into explicitly.
# NOTE THE FORMAT: pydantic-settings parses a tuple/list field from the
# environment as JSON, so this must be a JSON array. A comma-separated string
# raises SettingsError at startup.
#   correct:   ["https://app.example","https://admin.example"]
#   incorrect: https://app.example,https://admin.example
# REQUIRED-WHEN-DEPLOYED (unless TITLEPIPE_SAME_ORIGIN_DEPLOYMENT=true)
TITLEPIPE_CORS_ALLOWED_ORIGINS=[]

# Set true only when the browser app is served from this same origin. Declaring
# it while also configuring an allowlist is refused: the two contradict.
TITLEPIPE_SAME_ORIGIN_DEPLOYMENT=false

# Host header allowlist, JSON array. Required when deployed: a service that
# accepts any Host can be made to emit absolute links pointing at an attacker's
# domain, and is a cache-poisoning target. Wildcards are refused.
#   ["app.titlepipe.example"]
# REQUIRED-WHEN-DEPLOYED
TITLEPIPE_ALLOWED_HOSTS=[]

# WorkOS sealed-session cookie password. EXACTLY 32 characters, or startup
# fails. The development default is a known placeholder and is refused when
# deployed. Generate with: python -c "import secrets; print(secrets.token_urlsafe(24)[:32])"
# REQUIRED-WHEN-DEPLOYED
TITLEPIPE_COOKIE_SEAL_PASSWORD=

# console | json. Unset follows the environment: console locally, JSON once a
# log shipper is reading. Event names and fields are identical either way.
TITLEPIPE_LOG_LEVEL=INFO
TITLEPIPE_LOG_RENDERER=

# Refused when false in a deployed environment. Exists so a test can prove the
# redaction processor is what removes a value.
TITLEPIPE_REDACTION_ENABLED=true


# --------------------------------------------------------------- Blind API ---
#
# Separate prefix because this is a separate deployable with separate
# credentials. It must never receive the Core API's variables.

# REQUIRED — no default.
TITLEPIPE_BLIND_ENVIRONMENT=development
TITLEPIPE_BLIND_HOST=127.0.0.1
TITLEPIPE_BLIND_PORT=8100
TITLEPIPE_BLIND_DEBUG=false
TITLEPIPE_BLIND_RELOAD=false
TITLEPIPE_BLIND_MOCK_AUTH_ENABLED=false
TITLEPIPE_BLIND_DOCS_ENABLED=true
# REQUIRED-WHEN-DEPLOYED (unless TITLEPIPE_BLIND_SAME_ORIGIN_DEPLOYMENT=true)
TITLEPIPE_BLIND_CORS_ALLOWED_ORIGINS=[]
TITLEPIPE_BLIND_SAME_ORIGIN_DEPLOYMENT=false
# REQUIRED-WHEN-DEPLOYED, JSON array
TITLEPIPE_BLIND_ALLOWED_HOSTS=[]
# REQUIRED-WHEN-DEPLOYED
TITLEPIPE_BLIND_COOKIE_SEAL_PASSWORD=
TITLEPIPE_BLIND_LOG_LEVEL=INFO
TITLEPIPE_BLIND_LOG_RENDERER=
TITLEPIPE_BLIND_REDACTION_ENABLED=true

# Isolation. Setting this at all makes the process refuse to start, in EVERY
# environment including development. It exists as a named variable so the
# refusal is discoverable rather than mysterious.
# TITLEPIPE_BLIND_CORE_DATABASE_URL=       # must stay unset, always

# The only storage location this service may be pointed at.
TITLEPIPE_BLIND_BLIND_STORAGE_PREFIX=blind-input


# ------------------------------------------------------- Extraction worker ---

# REQUIRED — no default.
TITLEPIPE_EXTRACTION_ENVIRONMENT=development
TITLEPIPE_EXTRACTION_DEBUG=false
TITLEPIPE_EXTRACTION_LOG_LEVEL=INFO
TITLEPIPE_EXTRACTION_LOG_RENDERER=
TITLEPIPE_EXTRACTION_REDACTION_ENABLED=true

TITLEPIPE_EXTRACTION_MAX_CONCURRENT_JOBS=4
TITLEPIPE_EXTRACTION_MAX_CONCURRENT_PROVIDER_CALLS=8

# Spend ceilings, in USD. These are a runaway guard, not a cost target — the
# owner mandate is accuracy first, cost second. A retry loop on a 181-page
# package is the classic bill surprise, so the ceiling is a value someone
# approved rather than one discovered on an invoice. The per-order ceiling must
# be less than or equal to the daily one, or startup fails: a per-order limit
# above the daily limit would never bind.
TITLEPIPE_EXTRACTION_DAILY_SPEND_CEILING_USD=25.00
TITLEPIPE_EXTRACTION_PER_ORDER_SPEND_CEILING_USD=2.50


# ----------------------------------------------------------- Render worker ---

# REQUIRED — no default.
TITLEPIPE_RENDER_ENVIRONMENT=development
TITLEPIPE_RENDER_DEBUG=false
TITLEPIPE_RENDER_LOG_LEVEL=INFO
TITLEPIPE_RENDER_LOG_RENDERER=
TITLEPIPE_RENDER_REDACTION_ENABLED=true
TITLEPIPE_RENDER_MAX_CONCURRENT_JOBS=2

# The DOCX-to-PDF converter must be internal. A public host is refused in every
# environment, including development: pointing at a hosted converter sends
# client documents to a third party, and that is not less true on a laptop.
TITLEPIPE_RENDER_GOTENBERG_URL=http://gotenberg:3000
TITLEPIPE_RENDER_GOTENBERG_TIMEOUT_SECONDS=120


# ------------------------------------------------------------ Not yet used ---
#
# Named here so the eventual values are not invented ad hoc. None is read by
# any service at this gate.
#
# Gate 2 — PostgreSQL. Distinct credentials per role; the application role is a
# non-owner without BYPASSRLS, and the migration role is never in a runtime
# connection string.
# TITLEPIPE_DATABASE_URL=
# TITLEPIPE_MIGRATION_DATABASE_URL=
# TITLEPIPE_WORKER_DATABASE_URL=
#
# The four below are read by `services/core-api/migrations/sql/roles.sql` — a
# one-off psql script, not by any service — and only while it runs. They are
# NAMES ONLY, deliberately valueless: the test suite injects a per-session
# throwaway for each, and a real value must never be written down here.
# `titlepipe_owner` is absent on purpose. It is NOLOGIN, owns every table, and
# has no password, because a table's owner bypasses RLS unless FORCE is set and
# so nothing may connect as it.
# TITLEPIPE_MIGRATION_PASSWORD=
# TITLEPIPE_APP_PASSWORD=
# TITLEPIPE_WORKER_PASSWORD=
# TITLEPIPE_BLIND_PASSWORD=
#
# Gate 4 — WorkOS.
# TITLEPIPE_WORKOS_API_KEY=
# TITLEPIPE_WORKOS_CLIENT_ID=
#
# Gate 5 — Cloudflare R2. The blind credential is a different key with access
# to blind-input only.
# TITLEPIPE_R2_ACCOUNT_ID=
# TITLEPIPE_R2_ACCESS_KEY_ID=
# TITLEPIPE_R2_SECRET_ACCESS_KEY=
#
# If a filesystem-backed local upload adapter is used, this must be an ABSOLUTE
# path outside the working tree. /data/ is the gitignored development default.
# Never write uploads into the repository — see docs/CONTEXT.md §19.
# TITLEPIPE_LOCAL_UPLOAD_ROOT=/data/titlepipe/uploads
